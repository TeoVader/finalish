    <!-- Login -->
    <string name="login_link_help_entry">¿Cuenta de Frame.io Legacy, o ninguna cuenta tras iniciar sesión?</string>
    <string name="login_link_help_title">Vincula tu cuenta de Frame.io a Adobe</string>
    <string name="login_link_help_body">Frame.io ahora inicia sesión con un Adobe ID. Es posible que las cuentas creadas con Google antes del paso a Adobe aún no estén vinculadas a uno: Adobe inicia tu sesión, pero no aparece ninguna cuenta de Frame.io.</string>
    <string name="login_link_help_step1">Inicia sesión en Adobe con el mismo correo electrónico que usa tu cuenta de Frame.io. Puedes usar “Continuar con Google” si es esa dirección.</string>
    <string name="login_link_help_step2">¿Sigues sin ver cuentas? Pide al soporte de Frame.io que vincule tu cuenta a un Adobe ID con ese correo. No se elimina nada: los proyectos y archivos se quedan como están.</string>
    <string name="login_link_help_step3">Cuando te lo confirmen, vuelve a iniciar sesión aquí.</string>
    <string name="login_link_help_keep_google">Después de vincularla, puedes seguir usando Google: en la página de Adobe, elige “Continuar con Google”.</string>
    <string name="login_link_help_email_support">Escribir al soporte de Frame.io</string>
    <string name="login_link_help_open_frameio">Abrir frame.io</string>
    <string name="login_link_help_sign_in_again">Ya la he vinculado, volver a iniciar sesión</string>
    <string name="login_v4_title">Solo Frame.io V4</string>
    <string name="login_v4_body">Final(ish) funciona con Frame.io V4 e inicia sesión con un Adobe ID. Las cuentas gestionadas por Adobe funcionan; las gestionadas por Frame.io, una vez vinculadas a un Adobe ID (los pasos de arriba). Frame.io pasará por su cuenta todas las cuentas a la gestión de Adobe, sin fecha anunciada. La mayoría de las cuentas Legacy ya están en V4; si la tuya no, un Owner o Admin puede actualizarla desde el menú de la cuenta en frame.io, o pregunta al soporte de Frame.io.</string>
    <string name="login_v4_learn_more">Sobre el paso a V4</string>
    <string name="login_error_missing_config">Primero añade un ID de cliente de Adobe y un URI de redirección.</string>
    <string name="login_error_unsupported_redirect">Este APK no puede recibir la redirección “%1$s://”. Vuelve a compilarlo con finalish.redirectUri configurado con ese valor o usa un URI de loopback como http://127.0.0.1:8765/callback.</string>
    <string name="login_title">Inicia sesión con tu\nAdobe ID</string>
    <string name="login_subtitle">Frame.io inicia sesión con un Adobe ID. Se abre la página segura de Adobe: Final(ish) nunca ve tu contraseña.</string>
    <string name="login_step1_title">Toca “Continuar con Adobe”</string>
    <string name="login_step1_detail">Se abre la página de inicio de sesión de Adobe</string>
    <string name="login_step2_title">Inicia sesión como en frame.io</string>
    <string name="login_step2_detail">Correo electrónico, Google o Apple: el mismo Adobe ID que en el sitio web</string>
    <string name="login_step3_title">Vuelves aquí con la sesión iniciada</string>
    <string name="login_step3_detail">La sesión se mantiene: no tienes que iniciarla cada vez</string>
