    <string name="login_link_help_entry">Account Frame.io Legacy, o nessun account dopo l\'accesso?</string>
    <string name="login_link_help_title">Collega il tuo account Frame.io ad Adobe</string>
    <string name="login_link_help_body">Ora per accedere a Frame.io si usa un Adobe ID. Gli account creati con Google prima del passaggio ad Adobe potrebbero non essere ancora collegati: Adobe ti fa accedere, ma non compare nessun account Frame.io.</string>
    <string name="login_link_help_step1">Accedi ad Adobe con la stessa email del tuo account Frame.io. Va bene anche “Continua con Google”, se è quell\'indirizzo.</string>
    <string name="login_link_help_step2">Ancora nessun account? Chiedi all\'assistenza Frame.io di collegare il tuo account a un Adobe ID con quella email. Non viene eliminato niente: progetti e file restano come sono.</string>
    <string name="login_link_help_step3">Quando te lo confermano, accedi di nuovo qui.</string>
    <string name="login_link_help_keep_google">Dopo il collegamento puoi continuare a usare Google: nella pagina Adobe scegli “Continua con Google”.</string>
    <string name="login_link_help_email_support">Scrivi all\'assistenza Frame.io</string>
    <string name="login_link_help_open_frameio">Apri frame.io</string>
    <string name="login_link_help_sign_in_again">L\'ho collegato, accedi di nuovo</string>
    <string name="login_v4_title">Solo Frame.io V4</string>
    <string name="login_v4_body">Final(ish) funziona con Frame.io V4 e accede con un Adobe ID. Gli account gestiti da Adobe funzionano; quelli gestiti da Frame.io funzionano dopo il collegamento a un Adobe ID (i passi qui sopra). Frame.io sposterà da sé tutti gli account sotto Adobe, senza una data annunciata. La maggior parte degli account Legacy è già su V4; se il tuo non lo è, un Owner o un Admin può aggiornarlo dal menu dell\'account su frame.io, oppure puoi chiedere al supporto Frame.io.</string>
    <string name="login_v4_learn_more">Il passaggio a V4</string>
    <string name="login_error_missing_config">Prima aggiungi un client ID Adobe e un URI di reindirizzamento.</string>
    <string name="login_error_unsupported_redirect">Questo APK non può ricevere il reindirizzamento “%1$s://”. Ricompila con finalish.redirectUri impostato su questo valore, oppure usa un URI di loopback come http://127.0.0.1:8765/callback.</string>
    <string name="login_title">Accedi con il tuo\nAdobe ID</string>
    <string name="login_subtitle">Per accedere a Frame.io si usa un Adobe ID. Si apre la pagina sicura di Adobe: Final(ish) non vede mai la tua password.</string>
    <string name="login_step1_title">Tocca “Continua con Adobe”</string>
    <string name="login_step1_detail">Si apre la pagina di accesso di Adobe</string>
    <string name="login_step2_title">Accedi come fai su frame.io</string>
    <string name="login_step2_detail">Email, Google o Apple: lo stesso Adobe ID del sito web</string>
    <string name="login_step3_title">Torni qui, con l\'accesso effettuato</string>
    <string name="login_step3_detail">Resti connesso: non devi accedere ogni volta</string>
    <string name="login_signing_in">Accesso in corso…</string>
    <string name="login_continue_with_adobe">Continua con Adobe</string>
    <string name="login_explore_demo">Esplora la demo</string>
    <string name="login_advanced_sign_in">Accesso avanzato</string>
    <string name="login_credential_title">La tua credenziale Adobe</string>
    <string name="login_credential_body">Crea una credenziale \"OAuth Native App\" con l\'API Frame.io nella Adobe Developer Console. Usa il suo reindirizzamento adobe+…://callback (se incluso in questo APK) o un URI di loopback come http://127.0.0.1:8765/callback.</string>
    <string name="login_client_id">Client ID</string>
    <string name="login_redirect_uri">URI di reindirizzamento</string>
    <string name="login_save_credential">Salva credenziale</string>
    <string name="login_unofficial_disclaimer">Client non ufficiale. Non affiliato, approvato o sponsorizzato da Adobe o Frame.io.</string>
    <string name="login_session_expired">Sessione scaduta</string>
    <string name="login_session_expired_body">Accedi di nuovo con Adobe. I tuoi file offline sono ancora qui.</string>
