    <!-- Login -->
    <string name="login_link_help_entry">Frame.io Legacy account, or no accounts after signing in?</string>
    <string name="login_link_help_title">Link your Frame.io account to Adobe</string>
    <string name="login_link_help_body">Frame.io now signs in with an Adobe ID. Accounts created with Google before the move to Adobe may not be linked to one yet: Adobe signs you in, but no Frame.io account shows up.</string>
    <string name="login_link_help_step1">Sign in to Adobe with the same email your Frame.io account uses. “Continue with Google” is fine if it\'s that address.</string>
    <string name="login_link_help_step2">Still no accounts? Ask Frame.io support to link your account to an Adobe ID with that email. Nothing is deleted: projects and files stay as they are.</string>
    <string name="login_link_help_step3">Once they confirm, sign in again here.</string>
    <string name="login_link_help_keep_google">After linking you can keep using Google: on the Adobe page choose “Continue with Google”.</string>
    <string name="login_link_help_email_support">Email Frame.io support</string>
    <string name="login_link_help_open_frameio">Open frame.io</string>
    <string name="login_link_help_sign_in_again">I\'ve linked it, sign in again</string>
    <string name="login_v4_title">Frame.io V4 only</string>
    <string name="login_v4_body">Final(ish) works with Frame.io V4 and signs in with an Adobe ID. Accounts managed by Adobe work; accounts managed by Frame.io work once they sign in with an Adobe ID (the steps above). Frame.io will move every account to Adobe management by itself, with no date announced yet. Most Legacy accounts are already on V4; if yours isn\'t, an Owner or Admin can update it from the account menu on frame.io, or ask Frame.io support.</string>
    <string name="login_v4_learn_more">About the move to V4</string>
    <string name="login_error_missing_config">Add an Adobe client ID and redirect URI first.</string>
    <string name="login_error_unsupported_redirect">This APK can\'t receive the redirect “%1$s://”. Rebuild with finalish.redirectUri set to it, or use a loopback URI like http://127.0.0.1:8765/callback.</string>
    <string name="login_title">Sign in with your\nAdobe ID</string>
    <string name="login_subtitle">Frame.io signs in with an Adobe ID. Adobe\'s secure page opens: Final(ish) never sees your password.</string>
    <string name="login_step1_title">Tap “Continue with Adobe”</string>
    <string name="login_step1_detail">Adobe\'s sign-in page opens</string>
    <string name="login_step2_title">Sign in as you do on frame.io</string>
    <string name="login_step2_detail">Email, Google or Apple: the same Adobe ID as the website</string>
    <string name="login_step3_title">You\'re back here, signed in</string>
    <string name="login_step3_detail">You stay signed in: no logging in every time</string>
