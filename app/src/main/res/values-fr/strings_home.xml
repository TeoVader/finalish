    <!-- Login -->
    <string name="login_link_help_entry">Compte Frame.io Legacy, ou aucun compte après la connexion ?</string>
    <string name="login_link_help_title">Associer votre compte Frame.io à Adobe</string>
    <string name="login_link_help_body">Frame.io utilise désormais un Adobe ID pour la connexion. Les comptes créés avec Google avant le passage à Adobe ne sont peut-être pas encore associés à un Adobe ID : Adobe vous connecte, mais aucun compte Frame.io n\'apparaît.</string>
    <string name="login_link_help_step1">Connectez-vous à Adobe avec l\'adresse e-mail de votre compte Frame.io. « Continuer avec Google » convient si c\'est cette adresse.</string>
    <string name="login_link_help_step2">Toujours aucun compte ? Demandez à l\'assistance Frame.io d\'associer votre compte à un Adobe ID avec cette adresse e-mail. Rien n\'est supprimé : les projets et les fichiers restent tels quels.</string>
    <string name="login_link_help_step3">Une fois la confirmation reçue, reconnectez-vous ici.</string>
    <string name="login_link_help_keep_google">Après l\'association, vous pouvez continuer à utiliser Google : sur la page Adobe, choisissez « Continuer avec Google ».</string>
    <string name="login_link_help_email_support">Écrire à l\'assistance Frame.io</string>
    <string name="login_link_help_open_frameio">Ouvrir frame.io</string>
    <string name="login_link_help_sign_in_again">C\'est associé, me reconnecter</string>
    <string name="login_v4_title">Frame.io V4 uniquement</string>
    <string name="login_v4_body">Final(ish) fonctionne avec Frame.io V4 et se connecte avec un Adobe ID. Les comptes gérés par Adobe fonctionnent ; ceux gérés par Frame.io, une fois liés à un Adobe ID (les étapes ci-dessus). Frame.io fera passer lui-même tous les comptes sous gestion Adobe, sans date annoncée. La plupart des comptes Legacy sont déjà en V4 ; si ce n\'est pas le cas du vôtre, un Owner ou un Admin peut le mettre à jour depuis le menu du compte sur frame.io, ou demandez au support Frame.io.</string>
    <string name="login_v4_learn_more">À propos du passage à V4</string>
    <string name="login_error_missing_config">Ajoutez d\'abord un ID client Adobe et une URI de redirection.</string>
    <string name="login_error_unsupported_redirect">Cet APK ne peut pas recevoir la redirection « %1$s:// ». Recompilez-le avec finalish.redirectUri défini sur cette valeur, ou utilisez une URI de bouclage comme http://127.0.0.1:8765/callback.</string>
    <string name="login_title">Connectez-vous avec\nvotre Adobe ID</string>
    <string name="login_subtitle">Frame.io utilise un Adobe ID pour la connexion. La page sécurisée d\'Adobe s\'ouvre : Final(ish) ne voit jamais votre mot de passe.</string>
    <string name="login_step1_title">Appuyez sur « Continuer avec Adobe »</string>
    <string name="login_step1_detail">La page de connexion d\'Adobe s\'ouvre</string>
    <string name="login_step2_title">Connectez-vous comme sur frame.io</string>
    <string name="login_step2_detail">E-mail, Google ou Apple : le même Adobe ID que sur le site</string>
    <string name="login_step3_title">Vous revenez ici, connecté</string>
    <string name="login_step3_detail">Vous restez connecté : pas besoin de vous identifier à chaque fois</string>
    <string name="login_signing_in">Connexion…</string>
    <string name="login_continue_with_adobe">Continuer avec Adobe</string>
    <string name="login_explore_demo">Découvrir la démo</string>
    <string name="login_advanced_sign_in">Connexion avancée</string>
    <string name="login_credential_title">Vos identifiants Adobe</string>
    <string name="login_credential_body">Créez des identifiants \"OAuth Native App\" avec l\'API Frame.io dans l\'Adobe Developer Console. Utilisez leur redirection adobe+…://callback (si elle est intégrée à cet APK) ou une URI de bouclage comme http://127.0.0.1:8765/callback.</string>
