    <string name="login_save_credential">Anmeldedaten speichern</string>
    <string name="login_unofficial_disclaimer">Inoffizieller Client. Nicht mit Adobe oder Frame.io verbunden, von ihnen unterstützt oder gesponsert.</string>
    <string name="login_session_expired">Sitzung abgelaufen</string>
    <string name="login_session_expired_body">Melde dich erneut mit Adobe an. Deine Offlinedateien sind noch da.</string>
